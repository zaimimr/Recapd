{
	"cli": {
		"version": ">= 13.4.2",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"ios": {
				"credentialsSource": "remote"
			},
			"android": {
				"credentialsSource": "remote"
			}
		},
		"preview": {
			"distribution": "internal",
			"ios": {
				"credentialsSource": "local"
			},
			"android": {
				"credentialsSource": "remote"
			}
		},
		"production": {
			"autoIncrement": true,
			"ios": {
				"credentialsSource": "local"
			},
			"android": {
				"credentialsSource": "remote"
			}
		}
	},
	"submit": {
		"production": {
			"ios": {
				"ascAppId": "6758083751",
				"appleId": "me@zaim.no"
			},
			"android": {
				"serviceAccountKeyPath": "credentials/android/serviceAccountKey.json"
			}
		}
	}
}
