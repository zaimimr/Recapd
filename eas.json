{
	"cli": {
		"version": ">= 13.4.2",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"ios": {
				"credentialsSource": "remote"
			},
			"android": {
				"credentialsSource": "remote"
			}
		},
		"preview": {
			"distribution": "internal",
			"ios": {
				"credentialsSource": "local"
			},
			"android": {
				"credentialsSource": "remote"
			}
		},
		"production": {
			"autoIncrement": true,
			"ios": {
				"credentialsSource": "remote"
			},
			"android": {
				"credentialsSource": "remote"
			}
		}
	},
	"submit": {
		"internal": {
			"ios": {
				"ascAppId": "6758083751",
				"appleId": "me@zaim.no",
				"ascApiKeyPath": "./credentials/ios/asc-api-key.p8",
				"ascApiKeyId": "734B75F2PY",
				"ascApiKeyIssuerId": "a2d1bd8d-dc23-4161-904a-9f088eef8144"
			},
			"android": {
				"serviceAccountKeyPath": "credentials/android/serviceAccountKey.json",
				"track": "internal"
			}
		},
		"production": {
			"ios": {
				"ascAppId": "6758083751",
				"appleId": "me@zaim.no"
			},
			"android": {
				"serviceAccountKeyPath": "credentials/android/serviceAccountKey.json",
				"track": "production"
			}
		}
	}
}
