{
	"expo": {
		"name": "Recapd",
		"slug": "recapd",
		"version": "1.14.2",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "recapd",
		"userInterfaceStyle": "dark",
		"newArchEnabled": true,
		"splash": {
			"image": "./assets/images/splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#0B0B12"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.zaimimran.recapd",
			"associatedDomains": ["applinks:recapd.app"],
			"infoPlist": {
				"NSPhotoLibraryUsageDescription": "Recapd needs access to your photos to share them with your event group.",
				"NSPhotoLibraryAddUsageDescription": "Recapd needs permission to save photos to your camera roll.",
				"NSCameraUsageDescription": "Recapd needs camera access to scan QR codes.",
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#0B0B12"
			},
			"edgeToEdgeEnabled": true,
			"package": "com.zaimimran.recapd",
			"intentFilters": [
				{
					"action": "VIEW",
					"autoVerify": true,
					"data": [{ "scheme": "https", "host": "recapd.app", "pathPrefix": "/join" }],
					"category": ["BROWSABLE", "DEFAULT"]
				}
			],
			"googleServicesFile": "./google-services.json",
			"permissions": [
				"READ_EXTERNAL_STORAGE",
				"WRITE_EXTERNAL_STORAGE",
				"CAMERA",
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.WRITE_EXTERNAL_STORAGE",
				"android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
				"android.permission.ACCESS_MEDIA_LOCATION",
				"android.permission.READ_MEDIA_IMAGES",
				"android.permission.READ_MEDIA_VIDEO",
				"android.permission.CAMERA"
			],
			"blockedPermissions": ["android.permission.READ_MEDIA_AUDIO"]
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-media-library",
				{
					"photosPermission": "Allow Recapd to access your photos to share them with your event group.",
					"savePhotosPermission": "Allow Recapd to save photos to your camera roll.",
					"isAccessMediaLocationEnabled": true
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "Allow Recapd to use your camera to scan QR codes."
				}
			],
			[
				"expo-notifications",
				{
					"icon": "./assets/images/icon.png",
					"color": "#7c3aed"
				}
			],
			"@react-native-community/datetimepicker",
			[
				"@sentry/react-native/expo",
				{
					"url": "https://sentry.io/",
					"organization": "zaim-imran",
					"project": "recapd"
				}
			],
			"expo-secure-store",
			"expo-video",
			"expo-background-task"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "3dae7426-c7d6-4c8d-b234-a28f7402db0b"
			},
			"sentryDsn": "https://a820e5063894b396bf61fae03cfb5b7c@o459446.ingest.us.sentry.io/4511441989271552"
		}
	}
}
