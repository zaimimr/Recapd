{
  "rewrites": [
    {
      "source": "/join/:code",
      "destination": "/api/join"
    },
    {
      "source": "/((?!api|assets|icon\\.png|app-store-badge\\.svg|google-play-badge\\.png|screenshots|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/support.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
